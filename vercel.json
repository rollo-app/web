{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/join/:code",
      "destination": "/join/index.html"
    },
    {
      "source": "/join/:code/",
      "destination": "/join/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/entrar",
      "destination": "/login",
      "permanent": true
    },
    {
      "source": "/entrar/",
      "destination": "/login",
      "permanent": true
    },
    {
      "source": "/soporte",
      "destination": "/support",
      "permanent": true
    },
    {
      "source": "/soporte/",
      "destination": "/support",
      "permanent": true
    },
    {
      "source": "/privacidad",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/privacidad/",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/terminos",
      "destination": "/terms",
      "permanent": true
    },
    {
      "source": "/terminos/",
      "destination": "/terms",
      "permanent": true
    }
  ]
}
